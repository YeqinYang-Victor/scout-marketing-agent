{
  "name": "scout-marketing-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "券商营销文案自动化生产 Agent —— 产业链侦察兵日报",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "server": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "pipeline": "tsx server/cli.ts",
    "report": "tsx server/export-report.ts",
    "mock-site": "tsx tools/mock-subscription-site.ts",
    "test": "npm run test:calendar && npm run test:window",
    "test:calendar": "tsx tools/test-trading-calendar.ts",
    "test:window": "tsx tools/test-trading-window.ts",
    "build:calendar": "tsx tools/build-trading-calendar.ts"
  },
  "dependencies": {
    "@tdesign-react/chat": "^1.0.2",
    "@tencent-ai/agent-sdk": "^0.3.43",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.0.0",
    "echarts": "^5.5.1",
    "express": "^4.18.2",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "sharp": "^0.33.5",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "less": "^4.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  }
}
