# ---- CodeBuddy Agent SDK（可选，用于大模型润色文案）----
# 方式一：使用 CodeBuddy CLI 登录后自动复用凭据（推荐）
#   codebuddy login
# 方式二：直接配置 API Key
CODEBUDDY_API_KEY=

# 可选：自定义网关地址
# CODEBUDDY_BASE_URL=

# ---- 业务配置 ----
# 后端服务端口
PORT=3000

# 文案润色默认使用的模型
SCOUT_MODEL=claude-sonnet-4

# ---- 订阅站凭据 ----
# config/data-sources.json 里用 "${变量名}" 引用，避免把账号密码写进会提交的配置文件。
# 复制本文件为 .env 并填入真实值即可（.env 已被 .gitignore 忽略）。
ZEN_USER=
ZEN_PASS=
